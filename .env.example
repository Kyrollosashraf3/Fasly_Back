# Copy this file to .env and fill in your real values

# App identity (used in FastAPI title/version)
# APP_NAME=Fasly - Sunday School API
# APP_VERSION=1.0.0
APP_DESCRIPTION=Church Sunday school follow-up: boys, attendance, teachers, follow-ups.
# Allowed frontend origins, comma-separated ("*" for dev)
CORS_ORIGINS=*

# Server
HOST=0.0.0.0
PORT=9001

# PostgreSQL - the only database the app talks to.
# The database itself must already exist; the tables are created on startup.
DATABASE_URL=postgresql://postgres:0244@localhost:5432/fasly_db

# Auth (JWT) - generate a strong random value for production
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# First admin account - created / repaired automatically on startup if both are set.
# ADMIN_PHONE is the number he signs in with: 01xxxxxxxxx
# If the same number also appears in SEED_SUPER_ADMINS_JSON it is skipped there,
# so the platform owner stays super_admin after every deploy.
ADMIN_PHONE=01000000001
ADMIN_PASSWORD=change-me-too

# Optional church admins (أبونا), one JSON array on one line:
# SEED_SUPER_ADMINS_JSON=[{"name":"اسم الخادم","phone":"01000000002","church":"اسم الكنيسة"}]
# Entries with no church fall back to DEFAULT_CHURCH_NAME. ADMIN_PHONE wins.

# Web push (الإشعارات). Generate once per server:
#   python scripts/make_vapid_keys.py
# Leave them empty and push switches itself off: the /notifications/vapid-key
# route answers 503, the in-app banner hides, and no reminder is scheduled.
# Keep this pair forever - regenerating it invalidates every phone already
# subscribed, and each servant has to re-enable from the app.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_EMAIL=mailto:you@example.com
# PUSH_TIMEZONE=Africa/Cairo
# Daily hours, 24h in PUSH_TIMEZONE. The reminders only fire while this server
# is running - the clock lives inside the app, not in a system cron.
# FOLLOW_UP_REMINDER_HOUR=15
# BIRTHDAY_REMINDER_HOUR=9
# WEDNESDAY_REMINDER_HOUR=10
