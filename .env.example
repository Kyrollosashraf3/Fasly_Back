# Copy this file to .env and fill in your real values

# App identity (used in FastAPI title/version)
# APP_NAME=Fasly - Sunday School API
# APP_VERSION=1.0.0
# Allowed frontend origins, comma-separated ("*" for dev)
# CORS_ORIGINS=*

# Auth (JWT) — generate a strong random value for production
# SECRET_KEY=change-me-in-production
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# First admin account — created automatically on startup if both are set
# ADMIN_MAIL=admin@church.com
# ADMIN_PASSWORD=change-me-too
# ADMIN_USER_NAME=Admin

# --- Firebase credentials: pick ONE ---
# A) Local dev: path to the service account file (gitignored, never commit it)
FIREBASE_CREDENTIALS=./test.json
# B) Hosting (Render): full service-account JSON in a single env var.
#    In Render dashboard -> Environment -> add:
#      Key:   FIREBASE_CREDENTIALS_JSON
#      Value: {"type":"service_account", ... }  (whole JSON, one line)
#    The app tries B first, then falls back to A.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Firestore collection names
COLLECTION_USER=users
COLLECTION_BOY=boys
COLLECTION_TEACHER=teachers
COLLECTION_ATTEND=attendance
COLLECTION_FOLLOWUP=follow_ups
COLLECTION_TEACHER_CHECK=teacher_checks
